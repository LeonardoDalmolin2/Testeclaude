# ============================================================
# Variáveis de ambiente do Estúdio de Visagismo
# Copie para `.env.local` (ignorado pelo git) e preencha.
# Na Vercel, configure as mesmas variáveis em Project Settings → Environment Variables.
# ============================================================

# Chave da API da Anthropic (Claude). OBRIGATÓRIA para gerar o dossiê.
# Obtenha em https://console.anthropic.com/
ANTHROPIC_API_KEY=

# (Opcional) Modelo Claude usado na análise da selfie. Padrão: claude-opus-4-8
ANTHROPIC_MODEL=claude-opus-4-8

# (Opcional) Porta do servidor NestJS em desenvolvimento local. Padrão: 3001
PORT=3001
